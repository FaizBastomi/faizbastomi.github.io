# MongoDB connection string (Atlas or local).
DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/portfolio"

# Secret path segment for the dashboard. Rotate monthly: any new random value
# invalidates every session and all old URLs 404. Leave unset to disable the dashboard.
# Generate with: openssl rand -hex 8
DASHBOARD_PATH=""

# Dashboard password. NOTE: Next expands $VAR in .env values, so a literal $ must be
# escaped as \$ -- quoting the value does NOT prevent expansion.
DASHBOARD_PASSWORD=""

# HMAC key for session cookies. Regenerate with: openssl rand -hex 32
SESSION_SECRET=""
